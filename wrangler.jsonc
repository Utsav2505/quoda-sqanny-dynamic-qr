{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sqanny",
  "main": "src/index.tsx",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "fea3602912f3939a9c3d8bc45c6b7829",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://quoda.codebyte.dev"
  },
  "routes": [
    { "pattern": "quoda.codebyte.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sqanny",
      "database_id": "8a09d1ea-9f16-44cd-985a-28f7ebf6bf60",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SCAN_COUNTERS", "id": "8653f3fe360e45c3849a7f09a3ddfa67" },
    { "binding": "RATE_LIMIT", "id": "ef8c00c97d8448da859882f941c2a851" },
    { "binding": "SESSION_CACHE", "id": "b95ee80e13da4fa1aca067f725c44208" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "quoda-assets" }
  ],
  "ai": { "binding": "AI" }
}
