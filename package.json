{
  "name": "sqanny",
  "version": "0.1.0",
  "description": "Dynamic QR codes that never break + scan analytics.",
  "type": "module",
  "license": "MIT",
  "author": "CHETNAVERSE AI SYSTEMS LLP",
  "scripts": {
    "dev": "npm run build:tokens && npm run build:web && npm run build:client && wrangler dev",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:web": "vite build",
    "dev:web": "vite",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build:tokens && npm run build:web && npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "hono": "^4.6.14",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.19",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.1.4",
    "wrangler": "4.12.1"
  }
}
