{
  "name": "sqanny",
  "version": "0.1.0",
  "description": "Dynamic QR codes that never break + scan analytics.",
  "type": "module",
  "license": "MIT",
  "author": "CHETNAVERSE AI SYSTEMS LLP",
  "scripts": {
    "dev": "npm run build:tokens && npm run build:client && wrangler dev",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:client": "node scripts/build-client.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build:tokens && npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.19",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.24.2",
    "js-yaml": "^5.4.2",
    "jsqr": "^1.4.0",
    "typescript": "^5.7.2",
    "vitest": "^3.1.4",
    "wrangler": "4.12.1"
  }
}
