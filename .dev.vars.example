# Copy to .dev.vars for local dev (gitignored). All optional for core flows.

# Email delivery for magic links. If unset, magic links are printed to the
# Worker console with a [DEV MAGIC LINK] banner (zero-setup local auth).
RESEND_API_KEY=

# fal.ai API key for premium AI wallpaper backgrounds (FLUX.2). If unset,
# backgrounds fall back to Cloudflare Workers AI, then a brand gradient.
FAL_KEY=

# Public URL used in magic links and QR redirect targets.
APP_URL=http://localhost:8787

# HMAC key used to pseudonymise scan IP addresses (see src/lib/iphash.ts).
# Set any random string locally. In production set it as a Worker secret:
#   npx wrangler secret put SCAN_HASH_SECRET
# If unset, scans are logged WITHOUT an ip_hash — unique-visitor counts are
# disabled. A raw IP is never stored either way.
SCAN_HASH_SECRET=

# Debug: log the raw client IP + parsed dimensions to the console on each scan.
# OFF by default and it should stay that way in production — console output is
# retained by Cloudflare when observability is enabled, which would quietly
# become a second store of raw addresses. Enable locally to debug.
# SCAN_LOG_IP=1
